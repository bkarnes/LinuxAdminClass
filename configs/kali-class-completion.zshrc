# --- kali-class completion ---
# Convenience aliases so students can type verify/hint right after running
# kali-class in the same terminal (they proxy to kali-class subcommands).

alias kverify='kali-class verify'
alias khint='kali-class hint'
alias knext='kali-class next'
alias kprogress='kali-class progress'
alias kexport='kali-class export'
alias kwhoami='kali-class whoami'
# --- end kali-class completion ---